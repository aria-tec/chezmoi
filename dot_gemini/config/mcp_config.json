{
  "mcpServers": {
    "google-trends": {
      "command": "npx",
      "args": [
        "-y",
        "google-trends-mcp"
      ]
    },
    "smithery": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/cli@latest",
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}
